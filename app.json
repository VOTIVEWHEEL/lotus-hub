{
  "expo": {
    "name": "Lotus Hub",
    "slug": "lotus-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lotushub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0F14"
      },
      "package": "com.lotushub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font"]
  }
}
